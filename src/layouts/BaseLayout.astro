---
import "../styles/global.css";

const {
  title = "Automato",
  description = "Automato（オートメイト）は、Excel・スプレッドシートの自動化、業務管理ツールの構築、RPA導入を支援する業務自動化サービスです。"
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-article-page-title>{title}</title>
    <meta name="description" content={description} data-article-description />
    <link rel="icon" href="/assets/logo-mark.png" />
  </head>
  <body>
    <header class="topbar" aria-label="サイトヘッダー">
      <a class="topbar-logo" href="/" aria-label="Automato ホーム">
        <img src="/assets/logo-wordmark.png" alt="Automato" />
      </a>
      <nav class="topbar-nav" aria-label="メニュー">
        <a href="/#article-title">Article</a>
        <a href="/#work-title">Work</a>
        <a href="/#contact-title">Contact</a>
      </nav>
    </header>

    <main class="page">
      <slot />
    </main>
  </body>
</html>
