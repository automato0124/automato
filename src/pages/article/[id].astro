---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDate,
  formatDateTimeAttribute,
  getArticle,
  getArticleDate,
  getArticles
} from "../../lib/microcms.js";

export async function getStaticPaths() {
  const articles = await getArticles(100);

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article }
  }));
}

let { article } = Astro.props;
article = article?.body ? article : await getArticle(article?.id);

const title = article?.title || "Article";
const dateValue = getArticleDate(article);
---

<BaseLayout title={`${title} | Automato`} description={`${title} | Automato`}>
  <div class="article-page">
    <article class="article-page-inner">
      <div class="section-kicker">AUTOMATO <span>ARTICLE</span></div>
      <p class="article-date"><time datetime={formatDateTimeAttribute(dateValue)}>{formatDate(dateValue)}</time></p>
      <h1>{title}</h1>
      <div class="article-body" set:html={article?.body || "<p>本文がありません。</p>"} />
      <p class="back-link"><a class="text-link" href="/article/">記事一覧へ戻る <span aria-hidden="true">↗</span></a></p>
    </article>
  </div>
</BaseLayout>
