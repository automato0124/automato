---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, formatDateTimeAttribute, getArticleDate, getArticles } from "../lib/microcms.js";

const articles = await getArticles(5);

const services = [
  { number: "01", label: "Excel / Sheets", title: "表計算の自動化", description: "いつものExcelやGoogleスプレッドシートを活かし、入力・集計・転記・通知を自動化します。", examples: "自動集計 / フォーム連携 / 定期レポート", illustration: "sheet" },
  { number: "02", label: "Business Tools", title: "業務システムの構築", description: "案件や顧客、請求など、自社の仕事の進め方に合った管理ツールをつくります。", examples: "案件管理 / 顧客管理 / ダッシュボード", illustration: "dashboard" },
  { number: "03", label: "RPA", title: "定型作業の自動化", description: "画面上の入力やデータ取得など、繰り返すパソコン操作をRPAで自動化します。", examples: "Web入力 / CSV取得 / ファイル整理", illustration: "rpa" }
];

const plans = [
  { name: "ミニトマト", price: "19,800", count: "月1件まで", rpa: "対象外", consult: "制作依頼時", summary: "まずは一つの業務から整えたい企業に。" },
  { name: "ミディアムトマト", price: "39,800", count: "月2件まで", rpa: "対応", consult: "月1テーマ", summary: "複数の業務を、継続して改善したい企業に。", recommended: true },
  { name: "ビッグトマト", price: "69,800", count: "月4件まで", rpa: "対応", consult: "月2テーマ", summary: "社内全体の自動化を進めたい企業に。" }
];
---

<BaseLayout>
  <section class="about section-block" id="about" aria-labelledby="about-title">
    <div class="section-frame">
      <div class="about-grid">
        <div class="about-art" aria-hidden="true">
          <div class="about-art-window"><img src="/assets/about-workflow.png" alt="" /></div>
        </div>
        <div class="about-copy">
          <p class="eyebrow">WHAT WE DO</p>
          <h2 id="about-title" class="hand-title">今ある仕事を<br />もっと<span class="title-accent">スムーズ</span>に。</h2>
          <p>Automatoは、法人向けの月額制業務自動化サービスです。今使っているExcelやGoogleスプレッドシート、業務フローを確認し、無理なく使い続けられる仕組みを設計します。</p>
          <p>制作して終わりではありません。契約期間中の保守と、毎月の制作・改善枠を使った継続的な見直しまで対応します。</p>
          <a class="text-link" href="#support">ご利用の流れを見る <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <dl class="business-info" aria-label="事業者情報">
        <div><dt>屋号・サービス名</dt><dd>Automato（オートメイト）</dd></div>
        <div><dt>代表者</dt><dd>寺崎 充来</dd></div>
        <div><dt>所在地</dt><dd>愛知県名古屋市千種区今池5-33-2</dd></div>
        <div><dt>設立</dt><dd>2026年1月24日</dd></div>
      </dl>
    </div>
  </section>

  <section class="services section-block paper-section" id="services" aria-labelledby="services-title">
    <div class="section-frame">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">WHAT WE CAN MAKE</p><h2 id="services-title" class="hand-heading">SERVICES</h2></div>
        <p>仕事の内容と今の運用に合わせて、必要な仕組みを組み立てます。自動化したい業務がまだ決まっていなくても、対象の整理からご相談いただけます。</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <div class={`service-art service-art-${service.illustration}`} aria-hidden="true">
              <span class="service-art-number">{service.number}</span>
              <img src={`/assets/service-${service.illustration}.png`} alt="" />
            </div>
            <div class="service-card-body">
              <p class="service-label">{service.label}</p>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <div class="service-examples">{service.examples}</div>
            </div>
          </article>
        ))}
      </div>
      <div class="center-action"><a class="outline-button" href="https://www.chatwork.com/automato">自動化について相談する <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="plans section-block" id="plans" aria-labelledby="plans-title">
    <div class="section-frame">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">MONTHLY SUPPORT</p><h2 id="plans-title" class="hand-heading">PLANS</h2></div>
        <p>初期費用はすべて0円。月ごとの制作・改善枠を使いながら、自動化の制作から保守、継続改善まで進めます。</p>
      </div>
      <div class="plan-grid">
        {plans.map((plan) => (
          <article class:list={["plan-card", { "plan-card-featured": plan.recommended }]}>
            {plan.recommended && <span class="recommend-tag">おすすめ</span>}
            <div class="plan-header"><img src="/assets/logo-mark.png" alt="" width="32" height="32" /><h3>{plan.name}</h3></div>
            <p class="plan-summary">{plan.summary}</p>
            <div class="plan-price"><span>月額</span><strong>¥{plan.price}</strong><span>税込</span></div>
            <dl>
              <div><dt>初期費用</dt><dd>0円</dd></div>
              <div><dt>制作・改善</dt><dd>{plan.count}</dd></div>
              <div><dt>表計算の自動化・システム構築</dt><dd>対応</dd></div>
              <div><dt>RPA導入</dt><dd>{plan.rpa}</dd></div >
              <div><dt>制作物の保守</dt><dd>対応</dd></div>
            </dl>
            <a class="plan-link" href="https://www.chatwork.com/automato">このプランを相談する <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <p class="plan-note">※ 制作・改善枠は翌月へ繰り越しません。依頼内容によって複数枠を使用する場合があります。対応範囲と必要な枠数は、着手前に確認します。最低利用期間は3か月です。</p>
    </div>
  </section>

  <section class="articles section-block dark-section" id="articles" aria-labelledby="articles-title">
    <div class="section-frame">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">FROM AUTOMATO</p><h2 id="articles-title" class="hand-heading">NEWS</h2></div>
        <p>Automatoからの記事とお知らせをお届けします。</p>
      </div>
      {articles.length > 0 ? (
        <ul class="article-list">
          {articles.map((article) => {
            const dateValue = getArticleDate(article);
            return <li><a href={`/article/${article.id}/`}><time datetime={formatDateTimeAttribute(dateValue)}>{formatDate(dateValue)}</time><span class="article-kind">ARTICLE</span><span class="article-title">{article.title || "タイトル未設定"}</span><span class="article-arrow" aria-hidden="true">↗</span></a></li>;
          })}
        </ul>
      ) : (
        <div class="articles-empty"><p>新しい記事を準備しています。</p><span>Keep improving, every day.</span></div>
      )}
      <a class="outline-button light-button" href="/article/">記事一覧を見る <span aria-hidden="true">→</span></a>
      <span class="dark-decoration" aria-hidden="true">Keep<br />Making!</span>
    </div>
  </section>

  <section class="support section-block paper-section" id="support" aria-labelledby="support-title">
    <div class="section-frame">
      <div class="support-banner"><img src="/assets/support-workflow.png" alt="" /></div>
      <div class="section-heading split-heading support-heading">
        <div><p class="eyebrow">WORKING TOGETHER</p><h2 id="support-title" class="hand-heading">SUPPORT</h2></div>
        <p>相談から制作、運用まで。Automatoがつくった仕組みを、日々の仕事の中で使い続けられるよう支援します。</p>
      </div>
      <div class="support-grid">
        <div><span class="support-icon" aria-hidden="true">①</span><h3>業務を聞く</h3><p>現在の作業や使っているファイルを確認し、自動化できる業務を整理します。</p></div>
        <div><span class="support-icon" aria-hidden="true">②</span><h3>仕組みをつくる</h3><p>内容と使用枠、納期に合意した後に制作。動作確認を経て納品します。</p></div>
        <div><span class="support-icon" aria-hidden="true">③</span><h3>運用を支える</h3><p>契約中は制作物の保守に対応。必要な追加や変更を毎月の枠で進めます。</p></div>
      </div>
      <div class="support-foot"><p>制作依頼・改善相談・不具合連絡は、契約後にChatworkでやり取りします。原則2営業日以内に受付または回答します。</p><a class="text-link" href="https://www.chatwork.com/automato">まずは相談する <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
